{
  "schemaVersion": 1,
  "id": "crolclient",
  "version": "${version}",
  "name": "CrolClient",
  "description": "Visual client mod for Minecraft 1.21.4 with glassmorphism UI, Plintus-style visuals",
  "authors": ["CrolTeam"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/crolclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.crolclient.CrolClientClient"
    ]
  },
  "mixins": [
    "crolclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
