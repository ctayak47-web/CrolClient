# ===================================
# TELEGRAM BOTS CONFIGURATION
# ===================================

# 1. Combined Bot (BOT_TOKEN)
# Основной двойной бот: сингулярное ядро + экономика GRAM
# Получи от @BotFather в Telegram
BOT_TOKEN=your_combined_bot_token_here

# 2. RegBot (BOT_TOKEN_DATA)
# Бот для анализа даты регистрации по Telegram ID
BOT_TOKEN_DATA=your_regbot_token_here

# 3. Profile Bot (BOT_TOKEN_PROFILE)
# Бот для генерации мокапа профиля iOS в стиле Telegram
BOT_TOKEN_PROFILE=your_profile_bot_token_here

# 4. CumBot (BOT_TOKEN_CUM)
# КончаБот со счётчиком кончи и командой выстрела
BOT_TOKEN_CUM=your_cumbot_token_here

# ===================================
# ADMINISTRATOR IDS
# ===================================

# ID администратора/-ов (для команд /дать и /забрать)
# Несколько ID через запятую: 123456789,987654321
ADMIN_IDS=your_admin_id_here

# ===================================
# WEB SERVER CONFIGURATION
# ===================================

# Порт для Flask веб-сервера (Render.com автоматически использует 8080)
PORT=8080

# ===================================
# DATABASE CONFIGURATION
# ===================================

# Путь к БД КончаБота (опционально)
# По умолчанию: data/cumbot.db
CUMBOT_DB_PATH=data/cumbot.db

# Путь к отчетам RegBot (опционально)
# По умолчанию: data/reports
REGBOT_REPORTS_DIR=data/reports
